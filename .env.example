# 复制本文件为 .env 并填入真实值（本地开发 DATABASE_URL 可留空，留空则用 SQLite）

# 本地开发
NODE_ENV=development
PORT=3000
SESSION_SECRET=换成一个随机长字符串

# 部署到免费平台（Render + Neon）时填入 Postgres 连接串，例如：
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# 邮箱验证码 SMTP（绑定邮箱 / 找回密码用；QQ/126/163 邮箱开启 SMTP 后填授权码）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=你的邮箱
# SMTP_PASS=邮箱授权码（不是登录密码）
# SMTP_FROM=你的邮箱

# 微信小程序登录（code2session）：AppID 公开可填；AppSecret 私密，只放环境变量绝不进代码
# WX_APPID=wx5ff3c051acb0c76
# WX_SECRET=<小程序 AppSecret>
